{
  "version": 3,
  "database": "../data/trader.sqlite3",
  "tickers": ["SNDK", "SNXX", "SNDQ", "MU", "SPY", "QQQ", "SOXX"],
  "early_closes": ["2026-11-27", "2026-12-24"],
  "live_polling": {
    "start": "04:00",
    "regular_open": "09:30",
    "regular_close": "16:00",
    "early_close": "13:00",
    "after_close_minutes": 5,
    "poll_seconds": 60
  },
  "bars": {
    "api_port": 8789,
    "backfill_days": 120,
    "sweep_days": 30,
    "poll_catchup_days": 7,
    "idle_seconds": 300,
    "retry_seconds": 30,
    "retry_max_seconds": 900,
    "provider": {
      "url": "https://agent.robinhood.com/mcp/trading",
      "bounds": "extended",
      "oauth_store": "../data/robinhood_oauth.json",
      "oauth_callback_port": 8765,
      "timeout_seconds": 300,
      "max_symbols_per_call": 3
    }
  },
  "algo": {
    "api_port": 8791,
    "evaluation_days": 60,
    "poll_seconds": 30
  },
  "signals": {
    "ema9": {
      "inputs": ["bar_metadata"],
      "params": {"name": "ema", "period": 9}
    },
    "sma9": {
      "inputs": ["bar_metadata"],
      "params": {"name": "sma", "period": 9}
    },
    "rsi14": {
      "inputs": ["bar_metadata"],
      "params": {"name": "rsi", "period": 14}
    },
    "momentum12": {
      "inputs": ["bar_metadata"],
      "params": {"name": "momentum", "period": 12}
    },
    "roc14": {
      "inputs": ["bar_metadata"],
      "params": {"name": "roc", "period": 14}
    },
    "cci14": {
      "inputs": ["bar_metadata"],
      "params": {"name": "cci", "period": 14}
    },
    "williams_r10": {
      "inputs": ["bar_metadata"],
      "params": {"name": "williams_r", "period": 10}
    },
    "atr14": {
      "inputs": ["bar_metadata"],
      "params": {"name": "atr", "period": 14}
    },
    "mfi14": {
      "inputs": ["bar_metadata"],
      "params": {"name": "mfi", "period": 14}
    },
    "adx10": {
      "inputs": ["bar_metadata"],
      "params": {"name": "adx", "period": 10}
    },
    "donchian20": {
      "inputs": ["bar_metadata"],
      "params": {"name": "donchian_channels", "period": 20}
    },
    "bollinger20_2": {
      "inputs": ["bar_metadata"],
      "params": {"name": "bollinger_bands", "period": 20, "num_std": 2}
    },
    "macd12_26_9": {
      "inputs": ["bar_metadata"],
      "params": {
        "name": "macd",
        "fast_period": 12,
        "slow_period": 26,
        "signal_period": 9
      }
    },
    "keltner20_2": {
      "inputs": ["bar_metadata"],
      "params": {"name": "keltner_channels", "period": 20, "multiplier": 2}
    },
    "supertrend10_3": {
      "inputs": ["bar_metadata"],
      "params": {"name": "supertrend", "period": 10, "multiplier": 3}
    },
    "vwap": {
      "inputs": ["bar_metadata"],
      "params": {"name": "vwap"}
    },
    "obv": {
      "inputs": ["bar_metadata"],
      "params": {"name": "obv"}
    },
    "pivot_classic": {
      "inputs": ["bar_metadata"],
      "params": {"name": "pivot_points", "method": "classic"}
    },
    "session": {
      "inputs": [],
      "params": {}
    },
    "orb5_range": {
      "function": "opening_range",
      "inputs": ["bars", "session"],
      "params": {
        "minutes": 5
      }
    },
    "orb5_rvol": {
      "function": "rvol_open",
      "inputs": ["bars", "session"],
      "params": {
        "cap_bars": 30,
        "baseline_sessions": 20
      }
    },
    "last_close": {
      "inputs": ["bars"],
      "params": {
        "include_interpolated": false
      }
    }
  },
  "algos": {
    "orb5": {
      "function": "range_breakout",
      "inputs": ["session", "orb5_range", "orb5_rvol", "last_close"],
      "params": {
        "direction": "both",
        "target_r": 2.0,
        "min_rvol": 1.0,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      },
      "trades": true
    }
  }
}
