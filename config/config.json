{
  "database": "../data/trader.sqlite3",
  "tickers": ["SNDK", "MU", "WDC", "SPY", "QQQ", "SPCX", "CBRS", "CRWV", "SKHY", "ASTS", "RKLB"],
  "early_closes": ["2026-11-27", "2026-12-24"],
  "live_polling": {
    "start": "04:00",
    "regular_open": "09:30",
    "regular_close": "16:00",
    "early_close": "13:00",
    "after_close_minutes": 240,
    "poll_seconds": 60
  },
  "bars": {
    "api_port": 8789,
    "history_start": "2026-07-06",
    "sweep_days": 30,
    "poll_catchup_days": 7,
    "idle_seconds": 300,
    "retry_seconds": 30,
    "retry_max_seconds": 900,
    "provider": {
      "url": "https://agent.robinhood.com/mcp/trading",
      "bounds": "extended",
      "oauth_store": "../data/robinhood_oauth.json",
      "oauth_callback_port": 8765,
      "timeout_seconds": 300,
      "max_symbols_per_call": 1
    }
  },
  "broker": {
    "enabled": true,
    "dollar_amount": "100.00",
    "shadow_options": true,
    "account_env": "TRADER_ROBINHOOD_ACCOUNT",
    "execution_tickers": {
      "SNDK": {
        "long": "SNXX",
        "short": "SNDQ"
      },
      "SPY": {
        "long": "SPXL",
        "short": "SPXS"
      },
      "QQQ": {
        "long": "TQQQ",
        "short": "SQQQ"
      },
      "SPCX": {
        "long": "SPCH",
        "short": "SSPC"
      },
      "RKLB": {
        "long": "RKLX",
        "short": "RKLZ"
      },
      "ASTS": {
        "long": "ASTX",
        "short": "ASTN"
      },
      "MU": {
        "long": "MUU",
        "short": "MUZ"
      }
    }
  },
  "algo": {
    "api_port": 8791,
    "evaluation_days": 60,
    "poll_seconds": 30
  },
  "algo_display_names": {
    "orb5": "10-Minute Opening Range Breakout",
    "failed_gap_reversal": "Failed Gap Reversal",
    "gap_play": "15-Minute Gap Continuation"
  },
  "signals": {
    "session": {
      "inputs": [],
      "params": {}
    },
    "relative_momentum": {
      "inputs": ["bars", "session"],
      "params": {
        "window_minutes": 10,
        "baseline_sessions": 20,
        "min_sessions": 8,
        "time_tolerance_minutes": 5,
        "min_momentum_pct": 0.05,
        "strong_percentile": 80.0
      }
    },
    "atr_session": {
      "inputs": ["bars", "session"],
      "params": {
        "sessions": 14
      }
    },
    "prior_session": {
      "inputs": ["bars", "session"],
      "params": {}
    },
    "orb5_range": {
      "function": "opening_range",
      "inputs": ["bars", "session"],
      "params": {
        "minutes": 10
      }
    },
    "or15": {
      "function": "opening_range",
      "inputs": ["bars", "session"],
      "params": {
        "minutes": 15
      }
    },
    "orb5_rvol": {
      "function": "rvol_open",
      "inputs": ["bars", "session"],
      "params": {
        "cap_bars": 30,
        "baseline_sessions": 10
      }
    },
    "last_close": {
      "inputs": ["bars"],
      "params": {
        "include_interpolated": false
      }
    },
    "shape": {
      "function": "shape_v1",
      "inputs": ["bars"],
      "params": {
        "history_sessions": 120,
        "min_sessions": 8,
        "stride_minutes": 5,
        "shape_base_rate_w": 0.1,
        "age_halflife_days": 365,
        "support_k": 8
      }
    }
  },
  "algos": {
    "orb5": {
      "function": "range_breakout",
      "inputs": ["session", "orb5_range", "orb5_rvol", "last_close"],
      "params": {
        "direction": "both",
        "target_r": 0.1,
        "min_rvol": 1.0,
        "minute_max": 15,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      }
    },
    "failed_gap_reversal": {
      "function": "failed_gap",
      "inputs": ["session", "prior_session", "atr_session", "last_close"],
      "params": {
        "gap_min_pct": 2.0,
        "risk_atr_frac": 0.25,
        "target_r": 0.75,
        "minute_min": 15,
        "minute_max": 120,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      }
    },
    "gap_play": {
      "function": "gap_continuation",
      "inputs": [
        "session",
        "prior_session",
        "or15",
        "atr_session",
        "orb5_rvol",
        "last_close"
      ],
      "params": {
        "gap_min_pct": 2.0,
        "risk_atr_frac": 0.2,
        "target_r": 0.5,
        "min_rvol": 1.0,
        "minute_min": 15,
        "minute_max": 60,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      }
    },
    "opening_drive": {
      "inputs": ["session", "atr_session", "last_close"],
      "params": {
        "confirm_minutes": 15,
        "minute_min": 15,
        "minute_max": 20,
        "min_drive_pct": 0.5,
        "drive_atr_frac": 0.2,
        "target_frac": 0.25,
        "stop_frac": 1.0,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      }
    },
    "opening_drive30": {
      "function": "opening_drive",
      "inputs": ["session", "atr_session", "last_close"],
      "params": {
        "confirm_minutes": 30,
        "minute_min": 30,
        "minute_max": 35,
        "min_drive_pct": 0.5,
        "drive_atr_frac": 0.3,
        "target_frac": 0.25,
        "stop_frac": 0.75,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      }
    }
  }
}
