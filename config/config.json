{
  "version": 2,
  "database": "../data/trader.sqlite3",
  "tickers": ["SNDK", "SNXX", "SNDQ", "MU", "SPY", "QQQ", "SOXX"],
  "early_closes": ["2026-11-27", "2026-12-24"],
  "live_polling": {
    "start": "04:00",
    "regular_close": "16:00",
    "early_close": "13:00",
    "after_close_minutes": 5,
    "poll_seconds": 60
  },
  "bars": {
    "api_port": 8789,
    "backfill_days": 120,
    "sweep_days": 30,
    "poll_catchup_days": 7,
    "idle_seconds": 300,
    "retry_seconds": 30,
    "retry_max_seconds": 900,
    "provider": {
      "url": "https://agent.robinhood.com/mcp/trading",
      "bounds": "extended",
      "oauth_store": "../data/robinhood_oauth.json",
      "oauth_callback_port": 8765,
      "timeout_seconds": 300,
      "max_symbols_per_call": 3
    }
  },
  "algo": {
    "api_port": 8791,
    "evaluation_days": 60,
    "poll_seconds": 30
  },
  "signals": {
    "ema9": {
      "inputs": ["bar_metadata"],
      "params": {"name": "ema", "period": 9}
    },
