{
  "database": "../data/trader.sqlite3",
  "tickers": ["SNDK", "MU", "WDC", "SPY", "QQQ", "SPCX", "CBRS", "CRWV", "SKHY", "ASTS", "RKLB"],
  "early_closes": ["2026-11-27", "2026-12-24"],
  "live_polling": {
    "start": "04:00",
    "regular_open": "09:30",
    "regular_close": "16:00",
    "early_close": "13:00",
    "after_close_minutes": 240,
    "poll_seconds": 60
  },
  "bars": {
    "api_port": 8789,
    "history_start": "2026-07-06",
    "sweep_days": 30,
    "poll_catchup_days": 7,
    "idle_seconds": 300,
    "retry_seconds": 30,
    "retry_max_seconds": 900,
    "provider": {
      "url": "https://agent.robinhood.com/mcp/trading",
      "bounds": "extended",
      "oauth_store": "../data/robinhood_oauth.json",
      "oauth_callback_port": 8765,
      "timeout_seconds": 300,
      "max_symbols_per_call": 1
    }
  },
  "broker": {
    "enabled": true,
    "dollar_amount": "100.00",
    "account_env": "TRADER_ROBINHOOD_ACCOUNT",
    "execution_tickers": {
      "SNDK": {
        "long": "SNXX",
        "short": "SNDQ"
      }
    }
  },
  "algo": {
    "api_port": 8791,
    "evaluation_days": 60,
    "poll_seconds": 30
  },
  "algo_display_names": {
    "orb5": "10-Minute Opening Range Breakout",
    "sentiment_pullback": "Opening Sentiment Pullback",
    "lateday_momentum": "Late-Day Momentum Continuation",
    "failed_gap_reversal": "Failed Gap Reversal",
    "gap_play": "15-Minute Gap Continuation",
    "day_extreme_reversal": "Intraday Extreme Reversal"
  },
  "signals": {
    "session": {
      "inputs": [],
      "params": {}
    },
    "relative_momentum": {
      "inputs": ["bars", "session"],
      "params": {
        "window_minutes": 10,
        "baseline_sessions": 20,
        "min_sessions": 8,
        "time_tolerance_minutes": 5,
        "min_momentum_pct": 0.05,
        "strong_percentile": 80.0
      }
    },
    "atr_session": {
      "inputs": ["bars", "session"],
      "params": {
        "sessions": 14
      }
    },
    "prior_session": {
      "inputs": ["bars", "session"],
      "params": {}
    },
    "first30_ret": {
      "inputs": ["bars", "session"],
      "params": {
        "bars": 30
      }
    },
    "session_extremes": {
      "inputs": ["bars", "session", "atr_session"],
      "params": {}
    },
    "orb5_range": {
      "function": "opening_range",
      "inputs": ["bars", "session"],
      "params": {
        "minutes": 10
      }
    },
    "or15": {
      "function": "opening_range",
      "inputs": ["bars", "session"],
      "params": {
        "minutes": 15
      }
    },
    "orb5_rvol": {
      "function": "rvol_open",
      "inputs": ["bars", "session"],
      "params": {
        "cap_bars": 30,
        "baseline_sessions": 10
      }
    },
    "last_close": {
      "inputs": ["bars"],
      "params": {
        "include_interpolated": false
      }
    },
    "opening_sentiment": {
      "inputs": ["bars", "session"],
      "params": {
        "market_tickers": ["SPY", "QQQ"],
        "minutes": 5,
        "min_market_move_pct": 0.0,
        "require_ticker_agreement": true
      }
    },
    "pullback": {
      "inputs": ["bars", "session", "opening_sentiment"],
      "params": {
        "early_minutes": 30,
        "early_window_minutes": 5,
        "late_window_minutes": 30,
        "late_market_strength_ratio": 1.0,
        "max_threshold_ratio": 1.25,
        "max_ticker_flip_ratio": 0.5,
        "entry_cutoff_minutes": 60,
        "baseline_sessions": 20,
        "min_baseline_sessions": 5,
        "percentile": 0.9,
        "min_extreme_distance_pct": 0.5
      }
    },
    "shape": {
      "function": "shape_v1",
      "inputs": ["bars"],
      "params": {
        "history_sessions": 120,
        "min_sessions": 8,
        "stride_minutes": 5,
        "shape_base_rate_w": 0.1,
        "age_halflife_days": 365,
        "support_k": 8
      }
    }
  },
  "algos": {
    "orb5": {
      "function": "range_breakout",
      "inputs": ["session", "orb5_range", "orb5_rvol", "last_close"],
      "params": {
        "direction": "both",
        "target_r": 0.1,
        "min_rvol": 1.0,
        "minute_max": 15,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      }
    },
    "sentiment_pullback": {
      "inputs": ["session", "opening_sentiment", "pullback", "last_close"],
      "params": {
        "early_minutes": 30,
        "early_hold_minutes": 3,
        "late_hold_minutes": 10,
        "take_profit_pct": 1.0,
        "stop_loss_pct": 1.5,
        "giveback_pct": 0.75,
        "pattern_exit": true,
        "flat_minutes": 5,
        "capital_fraction": 0.5
      }
    },
    "lateday_momentum": {
      "function": "momentum_continuation",
      "inputs": [
        "session",
        "first30_ret",
        "atr_session",
        "orb5_rvol",
        "last_close"
      ],
      "params": {
        "first30_min_pct": 2.0,
        "risk_atr_frac": 0.15,
        "target_r": 0.5,
        "min_rvol": 1.25,
        "minute_min": 359,
        "minute_max": 380,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      }
    },
    "failed_gap_reversal": {
      "function": "failed_gap",
      "inputs": ["session", "prior_session", "atr_session", "last_close"],
      "params": {
        "gap_min_pct": 2.0,
        "risk_atr_frac": 0.25,
        "target_r": 0.75,
        "minute_min": 15,
        "minute_max": 120,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      }
    },
    "gap_play": {
      "function": "gap_continuation",
      "inputs": [
        "session",
        "prior_session",
        "or15",
        "atr_session",
        "orb5_rvol",
        "last_close"
      ],
      "params": {
        "gap_min_pct": 2.0,
        "risk_atr_frac": 0.2,
        "target_r": 0.5,
        "min_rvol": 1.0,
        "minute_min": 15,
        "minute_max": 60,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      }
    },
    "day_extreme_reversal": {
      "function": "extreme_fade",
      "inputs": [
        "session",
        "session_extremes",
        "atr_session",
        "orb5_rvol",
        "last_close"
      ],
      "params": {
        "min_range_atr": 1.0,
        "stop_atr_frac": 0.35,
        "target_r": 0.35,
        "confirmation_bars": 2,
        "min_rvol": 1.0,
        "minute_min": 60,
        "minute_max": 380,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      }
    },
    "opening_drive": {
      "inputs": ["session", "atr_session", "last_close"],
      "params": {
        "confirm_minutes": 15,
        "minute_min": 15,
        "minute_max": 20,
        "min_drive_pct": 0.5,
        "drive_atr_frac": 0.2,
        "target_frac": 0.25,
        "stop_frac": 1.0,
        "entry_cutoff_minutes": 10,
        "flat_minutes": 5
      }
    }
  }
}
